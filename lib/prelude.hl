; HiLisp prelude — standard utility library
; Load with:  ./hilisp lib/prelude.hl your-program.hl

; ── list ────────────────────────────────────────────────────────────────

; (range lo hi) → (lo lo+1 ... hi-1)
; e.g. (range 0 5) → (0 1 2 3 4)
(defn range (lo hi)
  (if (>= lo hi) (list) (cons lo (range (+ lo 1) hi))))

; (take n xs) → first n elements
(defn take (n xs)
  (if (or (<= n 0) (= (length xs) 0))
    (list)
    (cons (car xs) (take (- n 1) (cdr xs)))))

; (drop n xs) → skip first n elements
(defn drop (n xs)
  (if (or (<= n 0) (= (length xs) 0))
    xs
    (drop (- n 1) (cdr xs))))

; (concat xs ys) → append two lists
(defn concat (xs ys)
  (if (= (length xs) 0)
    ys
    (cons (car xs) (concat (cdr xs) ys))))

; (reverse xs) → reversed list
(defn reverse_acc (xs acc)
  (if (= (length xs) 0)
    acc
    (reverse_acc (cdr xs) (cons (car xs) acc))))
(defn reverse (xs) (reverse_acc xs (list)))

; (nth n xs) → element at index n (0-based)
(defn nth (n xs)
  (if (= n 0)
    (car xs)
    (nth (- n 1) (cdr xs))))

; (last xs) → last element
(defn last (xs)
  (if (= (length (cdr xs)) 0)
    (car xs)
    (last (cdr xs))))

; (flatten xs) → flatten one level of nesting
(defn flatten (xs)
  (if (= (length xs) 0)
    (list)
    (concat (car xs) (flatten (cdr xs)))))

; (contains x xs) → true if x is in xs (structural equality)
(defn contains (x xs)
  (if (= (length xs) 0)
    false
    (if (= x (car xs)) true (contains x (cdr xs)))))

; (replicate n x) → list of n copies of x
; e.g. (replicate 3 0) → (0 0 0)
(defn replicate (n x)
  (if (<= n 0) (list) (cons x (replicate (- n 1) x))))

; ── higher-order ────────────────────────────────────────────────────────

; (map f xs) → apply f to every element
(defn map (f xs)
  (if (= (length xs) 0) (list)
    (cons (f (car xs)) (map f (cdr xs)))))

; (filter pred xs) → keep elements where pred is true
(defn filter (pred xs)
  (if (= (length xs) 0) (list)
    (if (pred (car xs))
      (cons (car xs) (filter pred (cdr xs)))
      (filter pred (cdr xs)))))

; (fold f acc xs) → left fold — (fold + 0 (list 1 2 3)) → 6
(defn fold (f acc xs)
  (if (= (length xs) 0)
    acc
    (fold f (f acc (car xs)) (cdr xs))))

; (any pred xs) → true if any element satisfies pred
(defn any (pred xs)
  (if (= (length xs) 0)
    false
    (if (pred (car xs)) true (any pred (cdr xs)))))

; (all pred xs) → true if every element satisfies pred
(defn all (pred xs)
  (if (= (length xs) 0)
    true
    (if (pred (car xs)) (all pred (cdr xs)) false)))

; (zip-with f xs ys) → apply f to corresponding pairs
(defn zip_with (f xs ys)
  (if (or (= (length xs) 0) (= (length ys) 0))
    (list)
    (cons (f (car xs) (car ys)) (zip_with f (cdr xs) (cdr ys)))))

; (zip xs ys) → list of 2-element lists
(defn zip (xs ys)
  (zip_with (fn (x y) (list x y)) xs ys))

; (take-while pred xs) → leading elements while pred holds
; e.g. (take-while odd '(1 3 4 5)) → (1 3)
(defn take_while (pred xs)
  (if (= (length xs) 0)
    (list)
    (if (pred (car xs))
      (cons (car xs) (take_while pred (cdr xs)))
      (list))))

; (drop-while pred xs) → skip leading elements while pred holds
; e.g. (drop-while odd '(1 3 4 5)) → (4 5)
(defn drop_while (pred xs)
  (if (= (length xs) 0)
    (list)
    (if (pred (car xs))
      (drop_while pred (cdr xs))
      xs)))

; (flat-map f xs) → map f over xs then flatten one level
; e.g. (flat-map (fn (x) (list x x)) '(1 2 3)) → (1 1 2 2 3 3)
(defn flat_map (f xs)
  (flatten (map f xs)))

; (scan f acc xs) → fold that keeps all intermediate values
; e.g. (scan + 0 '(1 2 3)) → (0 1 3 6)
(defn scan (f acc xs)
  (if (= (length xs) 0)
    (list acc)
    (cons acc (scan f (f acc (car xs)) (cdr xs)))))

; (windows n xs) → all contiguous sub-lists of length n
; e.g. (windows 3 '(1 2 3 4 5)) → ((1 2 3) (2 3 4) (3 4 5))
(defn windows (n xs)
  (if (> n (length xs))
    (list)
    (cons (take n xs) (windows n (cdr xs)))))

; (intersperse sep xs) → insert sep between every element
; e.g. (intersperse 0 '(1 2 3)) → (1 0 2 0 3)
(defn intersperse (sep xs)
  (if (or (= (length xs) 0) (= (length (cdr xs)) 0))
    xs
    (cons (car xs) (cons sep (intersperse sep (cdr xs))))))

; (partition pred xs) → (list matching non-matching) — split xs in two
; e.g. (partition even '(1 2 3 4 5)) → ((2 4) (1 3 5))
(defn partition_acc (pred xs yes no)
  (if (= (length xs) 0)
    (list yes no)
    (if (pred (car xs))
      (partition_acc pred (cdr xs) (concat yes (list (car xs))) no)
      (partition_acc pred (cdr xs) yes (concat no (list (car xs)))))))
(defn partition (pred xs) (partition_acc pred xs (list) (list)))

; (find pred xs) → first element matching pred, or nil
(defn find (pred xs)
  (if (= (length xs) 0)
    nil
    (if (pred (car xs))
      (car xs)
      (find pred (cdr xs)))))

; (count-if pred xs) → number of elements satisfying pred
(defn count_if (pred xs)
  (fold (fn (acc x) (if (pred x) (+ acc 1) acc)) 0 xs))

; (enumerate xs) → list of (index element) pairs, 0-based
; e.g. (enumerate '(a b c)) → ((0 a) (1 b) (2 c))
(defn enumerate_from (xs i)
  (if (= (length xs) 0)
    (list)
    (cons (list i (car xs)) (enumerate_from (cdr xs) (+ i 1)))))
(defn enumerate (xs) (enumerate_from xs 0))

; ── math ────────────────────────────────────────────────────────────────

; (abs n) → absolute value
(defn abs (n) (if (< n 0) (- 0 n) n))

; (mod a b) → integer modulo  (e.g. (mod 17 5) → 2)
(defn mod (a b) (- a (* b (/ a b))))

; (max2 a b) → larger of two numbers
(defn max2 (a b) (if (> a b) a b))

; (min2 a b) → smaller of two numbers
(defn min2 (a b) (if (< a b) a b))

; (sum xs) → sum of a list of numbers
(defn sum (xs) (fold + 0 xs))

; (product xs) → product of a list of numbers
(defn product (xs) (fold * 1 xs))

; (clamp n lo hi) → n constrained to [lo, hi]
(defn clamp (n lo hi) (max2 lo (min2 n hi)))

; (inc n) / (dec n) → increment / decrement
(defn inc (n) (+ n 1))
(defn dec (n) (- n 1))

; (even n) / (odd n) → parity checks
(defn even (n) (= (mod n 2) 0))
(defn odd  (n) (not (even n)))

; (square n) → n * n
(defn square (n) (* n n))

; (gcd a b) → greatest common divisor (Euclidean algorithm)
(defn gcd (a b) (if (= b 0) a (gcd b (mod a b))))

; (lcm a b) → least common multiple
(defn lcm (a b) (/ (* a b) (gcd a b)))

; ── string ──────────────────────────────────────────────────────────────

; (repeat-str s n) → s concatenated n times
(defn repeat_str (s n)
  (if (<= n 0) "" (str s (repeat_str s (- n 1)))))

; (join sep xs) → join list of strings with separator
; e.g. (join ", " (list "a" "b" "c")) → "a, b, c"
(defn join (sep xs)
  (if (= (length xs) 0)
    ""
    (fold (fn (acc x) (str acc (str sep x)))
          (str (car xs))
          (cdr xs))))
